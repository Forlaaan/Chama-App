    "frontend:preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "africastalking": "^0.7.3",
    "axios": "^1.7.9",
    "better-sqlite3-multiple-ciphers": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
