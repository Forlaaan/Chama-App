{
  "name": "chama-governance-backend",
  "version": "1.0.0",
  "description": "Node.js + Express.js backend for the Mobile-Based Governance System for Transparency in Kenyan Chamas.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node initDatabase.js",
    "frontend:dev": "npm --prefix frontend run dev",
